include "slacks.mzn";
include "all_different.mzn";
int: n;
int: l;
int: u;
array [1..n] of var int: al_slack :: output = slack_link(al, al_slack_down, al_slack_up, 10, 0);
array [1..n] of var int: au_slack :: output = slack_link(au, au_slack_down, au_slack_up, 0, 10);
array [1..n] of var int: x;
constraint forall ( i in 1..n ) ( x[i]>=al_slack[i] /\ x[i]<=au_slack[i] );
constraint all_different(x);
include "slacks_internal.mzn";
array [1..n] of int: al = [ l | i in 1..n ];
array [1..n] of var 0..0: al_slack_up;
array [1..n] of var 0..10: al_slack_down;
array [1..n] of int: au = [ u | i in 1..n ];
array [1..n] of var 0..10: au_slack_up;
array [1..n] of var 0..0: au_slack_down;
all_slacks = al_slack_up++al_slack_down++au_slack_up++au_slack_down;
constraint slack_configure_objective();
solve minimize slack_objective;
constraint old_objective==0;
