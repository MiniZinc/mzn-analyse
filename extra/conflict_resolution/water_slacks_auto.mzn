include "slacks.mzn";
set of int: Res;
array [Res] of int: min_level;
array [Res] of var 0..100: max_level_slack = slack_link(max_level, max_level_slack_down, max_level_slack_up, 10, 10);
var int: total_water_slack = slack_link(total_water, total_water_slack_down, total_water_slack_up, 20, 0);
array [Res] of var 0..infinity: water_level;
constraint (sum(water_level)==total_water_slack) :: mzn_constraint_name("All water must be in a reservoir");
constraint forall ( r in Res ) ( (min_level[r]<=water_level[r]) :: mzn_expression_name("Lower "++format(r)++"") /\ (water_level[r]<=max_level_slack[r]) :: mzn_expression_name("Upper "++format(r)++"") ) :: mzn_constraint_name("Reservoirs have capacities and min-levels");
solve minimize slack_objective;
include "slacks_internal.mzn";
array [Res] of 0..100: max_level;
array [Res] of var 0..10: max_level_slack_up;
array [Res] of var 0..10: max_level_slack_down;
int: total_water;
var 0..0: total_water_slack_up;
var 0..20: total_water_slack_down;
all_slacks = max_level_slack_up++max_level_slack_down++[total_water_slack_up]++[total_water_slack_down];
constraint slack_configure_objective();
constraint old_objective==sum(water_level);
