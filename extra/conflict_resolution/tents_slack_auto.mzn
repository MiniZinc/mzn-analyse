include "slacks.mzn";
int: n;
set of int: row = 1..n;
set of int: col = 1..n;
array [row, col] of 0..1: a;
array [row] of var int: row_sums_slack = slack_link(row_sums, row_sums_slack_down, row_sums_slack_up, 0, 10);
array [col] of var int: col_sums_slack = slack_link(col_sums, col_sums_slack_down, col_sums_slack_up, 0, 10);
set of int: ROW = 0..n+1;
set of int: COL = 0..n+1;
array [ROW, COL] of var 0..1: t;
constraint forall ( r in {0, n+1}, c in COL ) ( t[r, c]==0 );
constraint forall ( r in ROW, c in {0, n+1} ) ( t[r, c]==0 );
constraint forall ( r in row, c in col ) ( if a[r, c]==1 then t[r, c]==0 else true endif );
constraint forall ( r in row ) ( sum ( c in col ) ( t[r, c] )==row_sums_slack[r] );
constraint forall ( c in col ) ( sum ( r in row ) ( t[r, c] )==col_sums_slack[c] );
constraint forall ( r in row, c in col where a[r, c]==1 ) ( t[r-1, c]+t[r+1, c]+t[r, c-1]+t[r, c+1]>=1 );
constraint forall ( r in row where r < n, c in col where c < n ) ( t[r, c]+t[r+1, c]+t[r, c+1]+t[r+1, c+1]<=1 );
solve :: int_search([ t[r, c] | r in row, c in col ], input_order, indomain_max, complete) minimize slack_objective;
include "slacks_objective.mzn";
array [row] of int: row_sums;
array [row] of var 0..10: row_sums_slack_up;
array [row] of var 0..0: row_sums_slack_down;
array [col] of int: col_sums;
array [col] of var 0..10: col_sums_slack_up;
array [col] of var 0..0: col_sums_slack_down;
all_slacks = row_sums_slack_up++row_sums_slack_down++col_sums_slack_up++col_sums_slack_down;
constraint slack_configure_objective();
constraint old_objective==0;
