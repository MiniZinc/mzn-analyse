include "cumulative.mzn";
include "slacks.mzn";
int: m;
array [1..m] of int: f;
int: r;
array [1..r, 1..m] of int: c;
int: n;
array [1..n] of var 1..r: t_slack = slack_link(t, t_slack_down, t_slack_up, 0, 10);
array [1..n] of var int: h_slack = slack_link(h, h_slack_down, h_slack_up, 0, 10);
array [1..n] of var int: w_slack = slack_link(w, w_slack_down, w_slack_up, 0, 10);
int: nl;
int: p;
array [1..p] of 1..4: typ;
array [1..p] of var 1..r: k1_slack = slack_link(k1, k1_slack_down, k1_slack_up, 0, 10);
array [1..p] of var int: d_slack = slack_link(d, d_slack_down, d_slack_up, 0, 10);
array [1..p] of var 1..r: k2_slack = slack_link(k2, k2_slack_down, k2_slack_up, 0, 10);
array [1..r] of int: duration = [ sum ( i in 1..n ) ( bool2int(t[i]==j)*h[i]*w[i] ) | j in 1..r ];
int: horiz = 1000;
array [1..n] of var 0..horiz: s;
array [1..n] of var 0..horiz: e = [ s[i]+h[i]*w[i] | i in 1..n ];
array [1..n] of var 1..nl: l;
var 0..horiz: makespan;
array [1..r] of var 0..horiz: start;
array [1..r] of var 0..horiz: end = [ start[i]+duration[i] | i in 1..r ];
array [1..r] of var 1..nl: line;
array [1..p] of var bool: followed;
var 0..p: violation = sum ( i in 1..p ) ( 1-bool2int(followed[i]) );
var 0..100*p+horiz: objective = 1000*violation+makespan;
constraint forall ( i in 1..n ) ( s[i]==start[t_slack[i]]+sum ( j in 1..i-1 ) ( bool2int(t_slack[i]==t_slack[j])*h_slack[j]*w_slack[j] ) /\ l[i]==line[t_slack[i]] );
constraint cumulative(start, duration, [ 1 | i in 1..r ], nl);
constraint forall ( i in 1..nl ) ( cumulative(start, duration, [ bool2int(line[j]==i) | j in 1..r ], 1) );
constraint forall ( i in 1..m ) ( cumulative(start, duration, [ c[k, i] | k in 1..r ], f[i]) );
constraint forall ( i in 1..p ) ( if typ[i]==1 then followed[i] -> end[k1_slack[i]]+d_slack[i]<=start[k2_slack[i]] else if typ[i]==2 then followed[i] -> end[k1_slack[i]]+d_slack[i]>=start[k2_slack[i]] else if typ[i]==3 then followed[i] -> start[k1_slack[i]]<=start[k2_slack[i]]+d_slack[i] else if typ[i]==4 then followed[i] -> end[k1_slack[i]]<=end[k2_slack[i]]+d_slack[i] else true endif endif endif endif );
constraint forall ( i in 1..r ) ( makespan>=end[i] );
solve :: seq_search([int_search(start, smallest, indomain_min, complete), int_search(line, input_order, indomain_min, complete), bool_search(followed, input_order, indomain_min, complete), int_search([makespan], input_order, indomain_min, complete)]) minimize slack_objective;
include "slacks_objective.mzn";
array [1..n] of 1..r: t;
array [1..n] of var 0..10: t_slack_up;
array [1..n] of var 0..0: t_slack_down;
array [1..n] of int: h;
array [1..n] of var 0..10: h_slack_up;
array [1..n] of var 0..0: h_slack_down;
array [1..n] of int: w;
array [1..n] of var 0..10: w_slack_up;
array [1..n] of var 0..0: w_slack_down;
array [1..p] of 1..r: k1;
array [1..p] of var 0..10: k1_slack_up;
array [1..p] of var 0..0: k1_slack_down;
array [1..p] of int: d;
array [1..p] of var 0..10: d_slack_up;
array [1..p] of var 0..0: d_slack_down;
array [1..p] of 1..r: k2;
array [1..p] of var 0..10: k2_slack_up;
array [1..p] of var 0..0: k2_slack_down;
all_slacks = t_slack_up++t_slack_down++h_slack_up++h_slack_down++w_slack_up++w_slack_down++k1_slack_up++k1_slack_down++d_slack_up++d_slack_down++k2_slack_up++k2_slack_down;
constraint slack_configure_objective();
constraint old_objective==objective;
