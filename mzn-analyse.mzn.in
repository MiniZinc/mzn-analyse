{
    "id": "org.minizinc.mzn-analyse",
    "description": "Tool for manipulating MiniZinc Models",
    "executable": "${REL_INSTALL_BINARY}",
    "inputType": "MZN",
    "isGUIApplication": false,
    "mznlib": "",
    "mznlibVersion": 1,
    "name": "mzn-analyse",
    "needsMznExecutable": false,
    "needsPathsFile": false,
    "needsSolns2Out": false,
    "needsStdlibDir": false,
    "stdFlags": [ ],
    "tags": [ "tool" ],
    "version": "1.0.0",
    "extraFlags": [
        ["--out", "Write model to out.mzn (- for stdout)", "bool", "true"],
        ["--out:out.mzn", "Write model to out.mzn (- for stdout)", "string", "out.mzn"],
        ["--out_fzn", "Write model to out.fzn (- for stdout)", "bool", "true"],
        ["--out_fzn:", "Write model to out.fzn (- for stdout)", "string", "out.fzn"],
        ["--no_out", "Disable automatic output insertion", "bool", "true"],
        ["--json_out", "Write collected json output to out.json (- for stdout)", "bool", "true"],
        ["--json_out:", "Write collected json output to out.json (- for stdout)", "string", "out.json"],
        ["--json_clear", "Clear collected json output", "bool", "true"],
        ["--no_json", "Disable automatic json output", "bool", "true"],
        ["--inline-includes", "Inline non-library includes", "bool", "true"],
        ["--inline-all-includes", "Inline all includes", "bool", "true"],
        ["--remove-anns", "Remove Id and Call annotations matching names", "bool", "true"],
        ["--remove-anns:", "Remove Id and Call annotations matching names", "string", "name"],
        ["--remove-includes", "Remove includes matching names", "bool", "true"],
        ["--remove-includes:", "Remove includes matching names", "string", "name"],
        ["--output-all", "Add 'add_to_output' annotation to all VarDecls", "bool", "true"],
        ["--remove-stdlib", "Remove stdlib includes", "bool", "true"],
        ["--remove-litter", "Remove variables and functions that stdlib leaves in the root Model after typecheck", "bool", "true"],
        ["--remove-litter-aggressive", "Remove variables and functions that stdlib leaves in the root Model after typecheck", "bool", "true"],
        ["--get-items", "Narrow to items indexed by idx1,...", "bool", "true"],
        ["--get-items:", "Narrow to items indexed by idx1,...", "string", "1"],
        ["--filter-items", "Only keep items matching iids", "bool", "true"],
        ["--filter-items:iid1,[iid2,...]", "Only keep items matching iids", "bool", "true"],
        ["--remove-items", "Remove items matching iids", "bool", "true"],
        ["--remove-items:", "Remove items matching iids", "string", "iid"],
        ["--filter-typeinst", "Just show var/par parts of model", "bool", "true"],
        ["--filter-typeinst:", "Just show var/par parts of model", "string", "par"],
        ["--replace-with-newvar", "Replace expressions with 'let' expressions", "bool", "true"],
        ["--replace-with-newvar:", "Replace expressions with 'let' expressions", "string", "path.mzn|sl|sc|el|ec"],
        ["--repeat-model:", "Make k copies of the model with unique ids (default: 2)", "string", "2"],
        ["--get-solve-anns", "Get solve annotations", "bool", "true"],
        ["--slackify", "Use in conjunction with slack.mzn annotations to build relaxed model", "bool", "true"],
        ["--sort", "Sort the model", "bool", "true"],
        ["--get-diversity-anns", "Extract solution diversity parameters from model", "bool", "true"],
        ["--annotate-data-deps", "Annotate expressions with their data dependencies", "bool", "true"],
        ["--get-term-types", "Write .terms file with types of objective terms", "bool", "true"],
        ["--get-term-types:", "Write .terms file with types of objective terms", "string", "out.terms"],
        ["--get-data-deps", "(FlatZinc only) Write .cons file with data dependenceis of FlatZinc constraints", "bool", "true"],
        ["--get-data-deps:", "(FlatZinc only) Write .cons file with data dependenceis of FlatZinc constraints", "string", "out.cons"],
        ["--get-exprs", "Extract list of expressions occurring inside location", "bool", "true"],
        ["--get-exprs:", "Extract list of expressions occurring inside location", "string", "path.mzn|sl|sc|el|ec"],
        ["--get-exprs-types", "Extract list of expressions with their types occurring inside location location = path.mzn|sl|sc|el|ec", "bool", "true"],
        ["--get-exprs-types:", "Extract list of expressions with their types occurring inside location location = path.mzn|sl|sc|el|ec", "string", "path.mzn|sl|sc|el|ec"],
        ["--get-ast", "Build JSON representation of AST for whole model or just for expression matching location1 or location2, place in json_store", "bool", "true"],
        ["--get-ast:", "Build JSON representation of AST for whole model or just for expression matching location1 or location2, place in json_store", "string", ""],
        ["--discretise", "Attempt to discretise a MIP flatzinc model", "bool", "true"],
        ["--discretise:", "Attempt to discretise a MIP flatzinc model", "string", "10"],
        ["--help", "Display this list of options", "bool", "false]
    ],
}
